# Database Connection
# Docker Compose default: postgresql://postgres:postgres@localhost:5432/workflow_db?schema=public
# Local Postgres example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/loopwork_v1?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workflow_db?schema=public"

# Redis Queue Connection
REDIS_URL="redis://localhost:6379"
# Set to "true" to skip Redis and use in-memory queue (fine for API-only local dev)
REDIS_MOCK="true"

# AI Model API Keys (use a real key for live Gemini calls; mock is used in dev when unset)
GEMINI_API_KEY="your_gemini_api_key_here"
# Set to "true" to force mock responses in development even with a real key
GEMINI_MOCK="false"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Application Ports & URLs
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Process mode: "api" (HTTP server) or "worker" (BullMQ consumer)
RUN_MODE="api"

# Optional: Slack webhook for approval notifications
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
